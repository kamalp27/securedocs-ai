# ==============================================================================
# SecureDocs AI — Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NEVER commit the actual .env file or real secrets into version control.
# ==============================================================================

# Application Metadata & Runtime Mode
PROJECT_NAME="SecureDocs AI"
ENVIRONMENT="development"
DEBUG=False
API_V1_STR="/api/v1"

# Security & Authentication (JWT)
# REQUIRED FOR STAGING / PRODUCTION: Must be a random secret of at least 32 characters.
# Generate on Linux/macOS/Windows PowerShell: openssl rand -hex 32
SECRET_KEY="generate-and-paste-random-secret-key-min-32-chars-here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ENABLE_HSTS=False  # Set to True only when deploying under verified HTTPS

# Refresh-Token Cookie & Anti-CSRF Configuration
REFRESH_COOKIE_NAME="securedocs_refresh_token"
REFRESH_COOKIE_PATH="/api/v1/auth"
REFRESH_COOKIE_HTTPONLY=True
REFRESH_COOKIE_SECURE=False  # Auto-enforced True in production/staging; set True under HTTPS
REFRESH_COOKIE_SAMESITE="lax"  # "lax", "strict", or "none"
REFRESH_COOKIE_DOMAIN=""  # Optional cookie domain for subdomains
CSRF_COOKIE_NAME="securedocs_csrf_token"
CSRF_HEADER_NAME="X-CSRF-Token"

# Rate Limiting & Network Security
RATE_LIMIT_ENABLED=True
TRUST_PROXY_HEADERS=False
TRUSTED_PROXIES=["127.0.0.1", "::1"]

# Database Connection (PostgreSQL or SQLite fallback for development)
# Production PostgreSQL example: postgresql+psycopg2://user:password@localhost:5432/securedocs_db
# Local SQLite fallback for testing: sqlite:///./securedocs.db
DATABASE_URL="sqlite:///./securedocs.db"

# Storage & File Uploads (Protected against direct public web access)
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB max file size
ALLOWED_MIME_TYPES=["application/pdf", "application/vnd.openxmlformats-officedocument.wordprocessingml.document", "text/plain", "text/markdown"]

# Vector Store & Embeddings (Local Sentence-Transformers & FAISS)
FAISS_INDEX_PATH="./data/faiss_indices/securedocs.index"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"
EMBEDDING_CACHE_DIR=""
CHUNK_SIZE=512
CHUNK_OVERLAP=50
SIMILARITY_TOP_K=5
MAX_SEARCH_TOP_K=50
SIMILARITY_THRESHOLD=0.45

# Evaluation & Benchmarks
EVALUATION_DATASET_PATH="./data/evaluation_benchmarks/golden_dataset.json"

# CORS Configuration (Allowed frontend origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Frontend Public Configuration (Used by Vite frontend client in frontend/.env)
VITE_API_URL="http://localhost:8000"
